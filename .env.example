# SMTP account used to deliver contact-form messages (server-side only).
# IONOS: host smtp.ionos.es, port 465, secure true, user = full mailbox address.
SMTP_HOST=smtp.ionos.es
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=formulario@example.com
SMTP_PASS=change-me
# Inbox that receives the inquiries.
CONTACT_TO=cdi@cdimaquinarias.com

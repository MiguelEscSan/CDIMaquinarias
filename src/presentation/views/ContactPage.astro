---
import PageLayout from "../layouts/PageLayout.astro";
import ContactForm from "../components/sections/ContactForm.astro";
import MapSection from "../components/sections/MapSection.astro";
import { getPage } from "@content/data/pages";
import type { Locale } from "@content/i18n";
import type { ContactFormState } from "./contactPageState";

interface Props {
  locale: Locale;
  state: ContactFormState;
}

const { locale, state } = Astro.props;
---

<PageLayout page={getPage("contact", locale)} locale={locale}>
  <section class="bg-slate-50 py-16 sm:py-24">
    <div class="mx-auto grid max-w-7xl gap-10 px-4 sm:px-6 lg:grid-cols-2 lg:items-start lg:gap-12 lg:px-8">
      <MapSection locale={locale} />
      <ContactForm state={state} locale={locale} />
    </div>
  </section>
</PageLayout>

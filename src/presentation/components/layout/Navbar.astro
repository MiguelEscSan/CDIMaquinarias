---
import Button from "../ui/Button.astro";
import Icon from "../ui/Icon.astro";
import LanguageSwitcher from "./LanguageSwitcher.astro";
import { mainNavIds, navLinks } from "@content/data/navigation";
import { primaryPhone, siteMeta } from "@content/data/siteInfo";
import { getDictionary, localizedPath, type Locale } from "@content/i18n";
import { isCurrentPath } from "@shared/lib/paths";
import type { PageId } from "@shared/types";

interface Props {
  locale: Locale;
  /** Current page, for the language switcher. */
  pageId: PageId;
}

const { locale, pageId } = Astro.props;
const t = getDictionary(locale).common;
const mainNav = navLinks(mainNavIds, locale);
const homePath = localizedPath("home", locale);
const callCta = { href: primaryPhone.href, ...t.cta.call };
const menuLabels = t.nav;
const pathname = Astro.url.pathname;
const current = (href: string) => (isCurrentPath(pathname, href) ? "page" : undefined);

const linkClass =
  "rounded-md px-3 py-2 text-sm font-semibold text-slate-700 transition-colors duration-300 hover:text-brand-hover aria-[current=page]:text-brand-hover aria-[current=page]:underline aria-[current=page]:decoration-2 aria-[current=page]:underline-offset-8 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-orange-500 focus-visible:ring-offset-2";
const mobileLinkClass =
  "flex min-h-12 items-center justify-between rounded-lg px-3 text-base font-semibold text-slate-800 hover:bg-slate-50 hover:text-brand-hover aria-[current=page]:bg-orange-50 aria-[current=page]:text-brand-hover focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-orange-500";
---

<header class="sticky top-0 z-50 border-b border-slate-200 bg-white/95 backdrop-blur supports-[backdrop-filter]:bg-white/80">
  <div class="mx-auto flex h-16 max-w-7xl items-center justify-between gap-4 px-4 sm:px-6 lg:h-20 lg:px-8">
    <a
      href={homePath}
      class="flex min-h-11 items-center gap-3 rounded-md focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-orange-500 focus-visible:ring-offset-2"
      aria-current={current(homePath)}
    >
      <img
        src="/brand/logo-cdi.webp"
        alt={siteMeta.name}
        width="2000"
        height="437"
        class="h-9 w-auto sm:h-10 lg:h-12"
      />
    </a>

    <nav aria-label={menuLabels.main} class="hidden lg:block">
      <ul class="flex items-center gap-1">
        {mainNav.map((link) => (
          <li>
            <a href={link.href} class={linkClass} aria-current={current(link.href)}>{link.label}</a>
          </li>
        ))}
      </ul>
    </nav>

    <div class="flex items-center gap-2">
      <LanguageSwitcher locale={locale} pageId={pageId} class="max-lg:hidden" />

      <details class="group relative lg:hidden" data-mobile-menu>
        <summary
          class="flex size-11 cursor-pointer list-none items-center justify-center rounded-lg border border-slate-300 text-slate-900 transition-colors duration-300 hover:bg-slate-100 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-orange-500 focus-visible:ring-offset-2"
        >
          <span class="sr-only">{menuLabels.toggle}</span>
          <Icon name="menu" class="group-open:hidden" />
          <Icon name="close" class="hidden group-open:block" />
        </summary>
        <nav
          aria-label={menuLabels.mobile}
          class="absolute right-0 mt-3 w-[min(20rem,calc(100vw-2rem))] rounded-2xl border border-slate-200 bg-white p-3 shadow-2xl"
        >
          <ul class="flex flex-col">
            {mainNav.map((link) => (
              <li>
                <a href={link.href} class={mobileLinkClass} aria-current={current(link.href)}>
                  {link.label}
                  <Icon name="arrow" size={18} class="text-slate-400" />
                </a>
              </li>
            ))}
          </ul>
          <LanguageSwitcher
            locale={locale}
            pageId={pageId}
            variant="full"
            landmark={false}
            class="mt-3 border-t border-slate-200 pt-3"
          />
          <div class="mt-3 border-t border-slate-200 pt-3">
            <Button href={callCta.href} ariaLabel={callCta.ariaLabel} fullWidth>
              <Icon name="phone" size={18} slot="icon" />
              {callCta.label}
            </Button>
          </div>
        </nav>
      </details>
    </div>
  </div>
</header>

<script is:inline>
  document.querySelectorAll("[data-mobile-menu] a").forEach((a) =>
    a.addEventListener("click", () => a.closest("details")?.removeAttribute("open")),
  );
</script>

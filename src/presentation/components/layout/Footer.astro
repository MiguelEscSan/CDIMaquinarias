---
import Icon from "../ui/Icon.astro";
import { footerNavIds, legalNavIds, navLinks } from "@content/data/navigation";
import {
  contactInfo,
  emailHref,
  formatAddress,
  formatHours,
  siteMeta,
} from "@content/data/siteInfo";
import { getDictionary, type Locale } from "@content/i18n";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const dict = getDictionary(locale);
const t = dict.common;
const footerNav = navLinks(footerNavIds, locale);
const legalNav = navLinks(legalNavIds, locale);
const legalName = siteMeta.legalName.replace(/[.]$/, "");
const year = new Date().getFullYear();
const headingClass = "font-mono text-xs font-semibold uppercase tracking-[0.2em] text-brand-accent";
const linkClass =
  "inline-flex min-h-11 items-center gap-2 rounded-md text-slate-300 transition-colors duration-300 hover:text-white focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-orange-500 focus-visible:ring-offset-2 focus-visible:ring-offset-navy";
---

<footer class="bg-navy text-slate-300">
  <div class="hazard-stripes h-1.5" aria-hidden="true"></div>
  <div class="mx-auto grid max-w-7xl gap-10 px-4 pt-14 pb-12 sm:px-6 md:grid-cols-2 lg:grid-cols-4 lg:px-8">
    <div class="flex flex-col gap-3">
      <p class="text-xl font-black tracking-tight text-white">{siteMeta.name}</p>
      <p class="text-sm">{t.business.positioning}</p>
      <p class="text-sm">{t.business.areaServed}</p>
    </div>

    <div>
      <h2 class={headingClass}>{t.footer.contactHeading}</h2>
      <ul class="mt-3 flex flex-col">
        {contactInfo.phones.map((phone) => (
          <li>
            <a href={phone.href} class={linkClass} aria-label={`${t.phoneLabels[phone.kind]}: ${phone.display}`}>
              <Icon name="phone" size={18} />
              {phone.display}
            </a>
          </li>
        ))}
        <li>
          <a href={emailHref} class={`${linkClass} break-all`}>
            <Icon name="mail" size={18} />
            {contactInfo.email}
          </a>
        </li>
      </ul>
      <address class="mt-3 flex gap-2 text-sm not-italic">
        <Icon name="map-pin" size={18} class="mt-0.5" />
        {formatAddress(t.countryName)}
      </address>
    </div>

    <div>
      <h2 class={headingClass}>{t.footer.hoursHeading}</h2>
      <dl class="mt-3 flex flex-col gap-2 text-sm">
        {contactInfo.hours.map((entry) => (
          <div class="flex justify-between gap-4 border-b border-slate-800 pb-2">
            <dt>{t.hours[entry.id]}</dt>
            <dd class="font-semibold text-white">{formatHours(entry, t.hours.closed)}</dd>
          </div>
        ))}
      </dl>
    </div>

    <nav aria-label={t.nav.footer}>
      <h2 class={headingClass}>{t.footer.navHeading}</h2>
      <ul class="mt-3 grid grid-cols-2 gap-x-4 md:grid-cols-1">
        {footerNav.map((link) => (
          <li>
            <a href={link.href} class={linkClass}>{link.label}</a>
          </li>
        ))}
      </ul>
    </nav>
  </div>

  <div class="border-t border-slate-800">
    <div class="mx-auto flex max-w-7xl flex-col gap-3 px-4 py-6 pb-28 text-xs text-slate-400 sm:px-6 md:flex-row md:items-center md:justify-between md:pb-6 lg:px-8">
      <p>{t.footer.copyright(year, legalName)}</p>
      <nav aria-label={t.nav.legal}>
        <ul class="flex flex-wrap gap-x-5">
          {legalNav.map((link) => (
            <li>
              <a href={link.href} class={linkClass}>{link.label}</a>
            </li>
          ))}
          <li data-cc-settings hidden>
            <button
              type="button"
              class={`${linkClass} cursor-pointer`}
              data-cc="show-preferencesModal"
              aria-haspopup="dialog"
            >
              {dict.cookies.labels.settings}
            </button>
          </li>
        </ul>
      </nav>
    </div>
  </div>
</footer>

---
import Button from "../ui/Button.astro";
import Icon from "../ui/Icon.astro";
import { stillBrand } from "@content/data/siteInfo";
import { getDictionary, type Locale } from "@content/i18n";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = getDictionary(locale);
const { company, distributor, catalog, catalogNote } = t.products;
---

<div class="bg-white py-16 sm:py-20">
  <div class="mx-auto grid max-w-7xl gap-10 px-4 sm:px-6 lg:grid-cols-2 lg:px-8">
    <section aria-labelledby="still-empresa-titulo" class="flex flex-col gap-5">
      <h2 id="still-empresa-titulo" class="text-3xl font-extrabold tracking-tight sm:text-4xl">{company.title}</h2>
      {company.paragraphs.map((p) => <p class="leading-relaxed text-slate-700 sm:text-lg">{p}</p>)}
      <ul class="mt-2 grid gap-3 sm:grid-cols-2">
        {t.common.stillCategories.map((category) => (
          <li class="flex min-h-12 items-center gap-3 rounded-xl border border-slate-200 bg-slate-50 px-4 font-semibold text-slate-800">
            <Icon name="forklift" size={20} class="text-brand-hover" />
            {category}
          </li>
        ))}
      </ul>
    </section>

    <section
      aria-labelledby="still-catalogo-titulo"
      class="relative flex flex-col gap-5 overflow-hidden rounded-3xl bg-navy p-6 text-slate-300 sm:p-10"
    >
      <div class="bg-grid absolute inset-0 opacity-50" aria-hidden="true"></div>
      <p class="relative text-6xl font-black tracking-tighter text-white sm:text-7xl" aria-hidden="true">
        {stillBrand.name}
      </p>
      <h2 id="still-catalogo-titulo" class="relative text-2xl font-extrabold tracking-tight text-white sm:text-3xl">
        {distributor.title}
      </h2>
      {distributor.paragraphs.map((p) => <p class="relative leading-relaxed sm:text-lg">{p}</p>)}
      <div class="relative flex flex-col gap-2">
        <div>
          <Button href={stillBrand.catalogUrl} ariaLabel={catalog.ariaLabel} external>
            {catalog.label}
            <Icon name="arrow" size={20} />
          </Button>
        </div>
        <p class="text-sm text-slate-400">{catalogNote}</p>
      </div>
    </section>
  </div>
</div>

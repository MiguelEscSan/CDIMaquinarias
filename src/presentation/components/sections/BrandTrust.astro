---
import Button from "../ui/Button.astro";
import Icon from "../ui/Icon.astro";
import SectionHeader from "../ui/SectionHeader.astro";
import { stillBrand } from "@content/data/siteInfo";
import { getDictionary, localizedPath, type Locale } from "@content/i18n";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = getDictionary(locale);
const brandContent = t.home.brand;
const productsPath = localizedPath("products", locale);

const headingId = "still-titulo";
---

<section
  aria-labelledby={headingId}
  class="relative overflow-hidden bg-navy py-16 text-slate-300 sm:py-24"
>
  <div class="bg-grid absolute inset-0 opacity-50" aria-hidden="true"></div>
  <div class="relative mx-auto grid max-w-7xl gap-12 px-4 sm:px-6 lg:grid-cols-2 lg:items-center lg:px-8">
    <div class="flex flex-col gap-6">
      <SectionHeader
        id={headingId}
        tone="dark"
        eyebrow={brandContent.eyebrow}
        title={brandContent.title}
        subtitle={brandContent.subtitle}
      />
      <p class="max-w-2xl leading-relaxed">{brandContent.body}</p>
      <div>
        <Button href={productsPath}>
          {brandContent.productsCtaLabel}
          <Icon name="arrow" size={20} />
        </Button>
      </div>
    </div>

    <div class="relative rounded-3xl border border-slate-700 bg-slate-900/70 p-6 sm:p-8">
      <div class="hazard-stripes absolute inset-x-0 top-0 h-1.5 rounded-t-3xl" aria-hidden="true"></div>
      <p
        class="text-6xl font-black tracking-tighter text-white sm:text-7xl"
        aria-hidden="true"
      >
        {stillBrand.name}
      </p>
      <h3 class="mt-6 font-mono text-xs font-semibold uppercase tracking-[0.2em] text-brand-accent">
        {brandContent.categoriesTitle}
      </h3>
      <ul class="mt-4 grid gap-3 sm:grid-cols-2">
        {t.common.stillCategories.map((category) => (
          <li class="flex min-h-12 items-center gap-3 rounded-xl border border-slate-700 bg-navy px-4 text-white transition-colors duration-300 hover:border-brand-accent">
            <Icon name="forklift" size={20} class="text-brand-accent" />
            {category}
          </li>
        ))}
      </ul>
    </div>
  </div>
</section>

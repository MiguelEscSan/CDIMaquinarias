---
import Card from "../ui/Card.astro";
import Icon from "../ui/Icon.astro";
import { getRentingCategories, rentingInquiryHref } from "@content/data/renting";
import { getDictionary, type Locale } from "@content/i18n";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const rentingCategories = getRentingCategories(locale);
const rentingCopy = getDictionary(locale).rental;
---

<div class="py-16 sm:py-20">
  <ul class="mx-auto grid max-w-7xl gap-6 px-4 sm:grid-cols-2 sm:px-6 lg:grid-cols-3 lg:px-8">
    {rentingCategories.map((category) => (
      <Card as="li" interactive class="group gap-4">
        <div class="flex aspect-[4/3] items-center justify-center overflow-hidden rounded-xl bg-slate-50">
          <img
            src={`/images/renting/${category.slug}.png`}
            alt=""
            width="800"
            height="800"
            loading="lazy"
            decoding="async"
            class="h-full w-full object-contain transition-transform duration-300 group-hover:scale-105 motion-reduce:transition-none motion-reduce:group-hover:scale-100"
          />
        </div>
        <h2 class="text-xl font-bold">{category.name}</h2>
        <a
          href={rentingInquiryHref(category, locale)}
          aria-label={rentingCopy.moreInfoAriaLabel(category.name)}
          class="mt-auto inline-flex min-h-11 items-center gap-2 self-start rounded-md font-bold text-brand-hover underline-offset-4 hover:underline focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-orange-500 focus-visible:ring-offset-2"
        >
          {rentingCopy.moreInfoLabel}
          <Icon name="arrow" size={18} />
        </a>
      </Card>
    ))}
  </ul>
</div>

---
import { getDictionary, type Locale } from "@content/i18n";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const aboutContent = getDictionary(locale).about;

const [experience, airConditioning] = aboutContent.sections;
const { lead, steps } = aboutContent.process;
const sectionId = (index: number) => `nosotros-${index}-titulo`;
---

<div class="bg-white py-20 sm:py-32">
  <div class="mx-auto flex max-w-5xl flex-col gap-24 px-4 sm:px-6 lg:px-8">
    {experience && (
      <section aria-labelledby={sectionId(0)} class="reveal grid items-center gap-12 lg:grid-cols-2 lg:gap-16">
        <div class="flex flex-col gap-6">
          <h2 id={sectionId(0)} class="text-4xl font-extrabold tracking-tight sm:text-5xl">{experience.title}</h2>
          {experience.paragraphs.map((p) => <p class="max-w-prose text-base leading-relaxed text-slate-700 sm:text-lg">{p}</p>)}
        </div>
        <img
          src="/images/cdi-showroom.webp"
          alt={aboutContent.imageAlt}
          width="683"
          height="512"
          loading="lazy"
          decoding="async"
          class="reveal aspect-[4/3] w-full rounded-3xl object-cover"
        />
      </section>
    )}

    <section>
      <p class="reveal max-w-3xl font-heading text-2xl font-extrabold leading-tight tracking-tight text-slate-900 sm:text-4xl">
        {lead}
      </p>
      <ol class="mt-14 grid list-none gap-10 md:grid-cols-4 md:gap-6">
        {
          steps.map((step) => (
            <li class="reveal flex flex-col gap-4">
              <span class="block h-1.5 w-12 rounded-full bg-brand" aria-hidden="true"></span>
              <h3 class="text-2xl font-bold leading-tight text-slate-900">{step.title}</h3>
              <p class="text-base leading-relaxed text-slate-600">{step.body}</p>
            </li>
          ))
        }
      </ol>
    </section>

    {airConditioning && (
      <section
        aria-labelledby={sectionId(1)}
        class="reveal flex flex-col gap-12 rounded-3xl bg-navy p-8 text-slate-300 sm:p-14"
      >
        <h2 id={sectionId(1)} class="text-3xl font-extrabold tracking-tight text-white sm:text-4xl lg:text-5xl">{airConditioning.title}</h2>
        <div class="grid items-center gap-12 lg:grid-cols-2 lg:gap-16">
          <div class="order-1 flex flex-col gap-6 lg:order-2">
            {airConditioning.paragraphs.map((p) => <p class="max-w-prose text-base leading-relaxed text-slate-300 sm:text-lg">{p}</p>)}
          </div>
          <img
            src="/images/climatizacion-industrial.jpg"
            alt=""
            width="1200"
            height="627"
            loading="lazy"
            decoding="async"
            class="order-2 aspect-[4/3] w-full rounded-2xl object-cover lg:order-1"
          />
        </div>
      </section>
    )}
  </div>
</div>

<style>
  .reveal {
    animation: rise 1s cubic-bezier(0.2, 0.7, 0.2, 1) both;
    animation-timeline: view();
    animation-range: entry 0% entry 35%;
  }

  @keyframes rise {
    from {
      opacity: 0;
      transform: translateY(24px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .reveal {
      animation: none;
    }
  }
</style>

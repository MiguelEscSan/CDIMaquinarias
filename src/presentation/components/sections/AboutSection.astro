---
import Icon from "../ui/Icon.astro";
import { getDictionary, type Locale } from "@content/i18n";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const aboutContent = getDictionary(locale).about;

const [experience, airConditioning] = aboutContent.sections;
const sectionId = (index: number) => `nosotros-${index}-titulo`;
---

<div class="bg-slate-50 py-16 sm:py-20">
  <div class="mx-auto flex max-w-5xl flex-col gap-14 px-4 sm:px-6 lg:px-8">
    {experience && (
      <section aria-labelledby={sectionId(0)} class="grid items-center gap-10 lg:grid-cols-2">
        <div class="flex flex-col gap-5">
          <h2 id={sectionId(0)} class="text-3xl font-extrabold tracking-tight sm:text-4xl">{experience.title}</h2>
          {experience.paragraphs.map((p) => <p class="leading-relaxed text-slate-700 sm:text-lg">{p}</p>)}
        </div>
        <img
          src="/images/cdi-showroom.webp"
          alt={aboutContent.imageAlt}
          width="683"
          height="512"
          loading="lazy"
          decoding="async"
          class="aspect-[4/3] w-full rounded-3xl object-cover shadow-lg"
        />
      </section>
    )}

    <p class="relative rounded-2xl border border-orange-200 bg-orange-50 p-6 pl-16 text-lg font-semibold leading-relaxed text-slate-900 sm:p-8 sm:pl-20">
      <Icon name="clipboard" size={28} class="absolute top-6 left-6 text-brand-hover sm:top-8 sm:left-8" />
      {aboutContent.highlight}
    </p>

    {airConditioning && (
      <section aria-labelledby={sectionId(1)} class="grid items-center gap-10 lg:grid-cols-2">
        <div class="order-1 flex flex-col gap-5 lg:order-2">
          <h2 id={sectionId(1)} class="text-3xl font-extrabold tracking-tight sm:text-4xl">{airConditioning.title}</h2>
          {airConditioning.paragraphs.map((p) => <p class="leading-relaxed text-slate-700 sm:text-lg">{p}</p>)}
        </div>
        <div
          aria-hidden="true"
          class="order-2 flex aspect-[4/3] w-full items-center justify-center rounded-3xl bg-slate-900 shadow-lg lg:order-1"
        >
          <Icon name="snowflake" size={120} class="text-brand-hover" />
        </div>
      </section>
    )}
  </div>
</div>

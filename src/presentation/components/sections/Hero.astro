---
import Badge from "../ui/Badge.astro";
import Button from "../ui/Button.astro";
import Icon from "../ui/Icon.astro";
import { primaryPhone } from "@content/data/siteInfo";
import { getDictionary, localizedPath, type Locale } from "@content/i18n";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = getDictionary(locale);
const hero = t.home.hero;
const quoteCta = { href: localizedPath("contact", locale), ...t.common.cta.quote };
const callCta = { href: primaryPhone.href, ...t.common.cta.call };

const headingId = "inicio-titulo";
---

<section
  aria-labelledby={headingId}
  class="relative isolate overflow-hidden bg-navy text-slate-300"
>
  <img
    src="/images/fachada-cdi-hero.jpg"
    alt=""
    width="2000"
    height="487"
    fetchpriority="high"
    class="absolute inset-0 -z-10 size-full object-cover"
    aria-hidden="true"
  />
  <div
    class="absolute inset-0 -z-10 bg-linear-to-r from-navy via-navy/85 to-navy/40"
    aria-hidden="true"
  ></div>
  <div class="hazard-stripes absolute inset-x-0 bottom-0 -z-10 h-1.5" aria-hidden="true"></div>

  <div class="relative mx-auto flex min-h-[78dvh] max-w-7xl flex-col justify-center gap-6 px-4 py-20 sm:px-6 sm:py-28 lg:px-8 lg:py-36">
    <p class="inline-flex w-fit items-center gap-2 rounded-full border border-brand-accent/40 bg-navy/60 px-3 py-1.5 font-mono text-xs font-semibold uppercase tracking-[0.2em] text-brand-accent backdrop-blur">
      <span class="size-2 rounded-full bg-brand-accent" aria-hidden="true"></span>
      {t.common.business.positioning.replace(/[.]$/, "")}
    </p>
    <h1 id={headingId} class="max-w-4xl text-5xl font-extrabold leading-[0.95] tracking-tight text-white sm:text-6xl lg:text-7xl">
      {t.seo.pages.home.heading}
    </h1>
    <p class="text-xl font-semibold text-brand-accent">{hero.tagline}</p>
    <p class="max-w-2xl text-base leading-relaxed text-slate-300 sm:text-lg">
      {t.common.business.valueProposition}
    </p>

    <div class="flex flex-col gap-3 sm:flex-row">
      <Button href={quoteCta.href} ariaLabel={quoteCta.ariaLabel} size="lg">
        <Icon name="mail" slot="icon" />
        {quoteCta.label}
      </Button>
      <Button
        href={callCta.href}
        ariaLabel={callCta.ariaLabel}
        size="lg"
        variant="inverse"
      >
        <Icon name="phone" slot="icon" />
        {callCta.label}
      </Button>
    </div>

    <ul class="flex flex-wrap gap-2 pt-2" aria-label={hero.keyPointsLabel}>
      {hero.trustChips.map((chip) => (
        <li>
          <Badge tone="light" size="md">
            <Icon name="check" size={14} strokeWidth={2.5} class="text-brand-accent" />
            {chip}
          </Badge>
        </li>
      ))}
    </ul>
  </div>
</section>

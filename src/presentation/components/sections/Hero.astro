---
import Badge from "../ui/Badge.astro";
import Button from "../ui/Button.astro";
import Icon from "../ui/Icon.astro";
import { primaryPhone } from "@content/data/siteInfo";
import { getDictionary, localizedPath, type Locale } from "@content/i18n";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = getDictionary(locale);
const hero = t.home.hero;
const quoteCta = { href: localizedPath("contact", locale), ...t.common.cta.quote };
const callCta = { href: primaryPhone.href, ...t.common.cta.call };

const headingId = "inicio-titulo";
---

<section
  aria-labelledby={headingId}
  class="relative overflow-hidden bg-navy text-slate-300"
>
  <div class="bg-grid absolute inset-0 opacity-60" aria-hidden="true"></div>
  <div
    class="absolute -top-32 -right-32 size-[28rem] rounded-full bg-brand/20 blur-3xl"
    aria-hidden="true"
  ></div>

  <div class="relative mx-auto grid max-w-7xl items-center gap-12 px-4 py-16 sm:px-6 sm:py-20 lg:grid-cols-12 lg:px-8 lg:py-28">
    <div class="flex flex-col gap-6 lg:col-span-7">
      <p class="flex items-center gap-2 font-mono text-xs font-semibold uppercase tracking-[0.2em] text-brand-accent">
        <span class="h-0.5 w-6 bg-current" aria-hidden="true"></span>
        {t.common.business.positioning.replace(/[.]$/, "")}
      </p>
      <h1 id={headingId} class="text-4xl font-black leading-tight tracking-tight text-white sm:text-5xl lg:text-6xl">
        {t.seo.pages.home.heading}
      </h1>
      <p class="text-xl font-semibold text-brand-accent">{hero.tagline}</p>
      <p class="max-w-2xl text-base leading-relaxed text-slate-300 sm:text-lg">
        {t.common.business.valueProposition}
      </p>

      <div class="flex flex-col gap-3 sm:flex-row">
        <Button href={quoteCta.href} ariaLabel={quoteCta.ariaLabel} size="lg">
          <Icon name="mail" slot="icon" />
          {quoteCta.label}
        </Button>
        <Button
          href={callCta.href}
          ariaLabel={callCta.ariaLabel}
          size="lg"
          variant="inverse"
        >
          <Icon name="phone" slot="icon" />
          {callCta.label}
        </Button>
      </div>

      <ul class="flex flex-wrap gap-2 pt-2" aria-label={hero.keyPointsLabel}>
        {hero.trustChips.map((chip) => (
          <li>
            <Badge tone="light" size="md">
              <Icon name="check" size={14} strokeWidth={2.5} class="text-brand-accent" />
              {chip}
            </Badge>
          </li>
        ))}
      </ul>
    </div>

    <div class="relative hidden lg:col-span-5 lg:block" aria-hidden="true">
      <div class="relative aspect-square overflow-hidden rounded-3xl border border-slate-700 shadow-2xl">
        <img
          src="/images/fachada-cdi-still.webp"
          alt=""
          width="960"
          height="960"
          class="size-full object-cover"
        />
        <div class="absolute inset-0 bg-linear-to-t from-navy/70 via-navy/10 to-transparent"></div>
      </div>
      <div class="hazard-stripes absolute -bottom-4 left-8 h-3 w-40 rounded-full"></div>
    </div>
  </div>
</section>

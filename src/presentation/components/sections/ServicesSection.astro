---
import Button from "../ui/Button.astro";
import Card from "../ui/Card.astro";
import Icon from "../ui/Icon.astro";
import SectionHeader from "../ui/SectionHeader.astro";
import { getServices } from "@content/data/services";
import { getDictionary, localizedPath, type Locale } from "@content/i18n";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const services = getServices(locale);
const servicesPath = localizedPath("services", locale);

const headingId = "servicios-titulo";
const { eyebrow, title, subtitle, moreLabel, allServicesLabel } = getDictionary(locale).home.services;
---

<section aria-labelledby={headingId} class="relative bg-slate-50 py-16 sm:py-24">
  <div class="bg-diagonal absolute inset-0" aria-hidden="true"></div>
  <div class="relative mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <SectionHeader id={headingId} eyebrow={eyebrow} title={title} subtitle={subtitle} />

    <ul class="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {services.map((service) => (
        <Card as="li" interactive class="group">
          <div class="flex size-12 items-center justify-center rounded-xl bg-orange-50 text-brand-hover ring-1 ring-orange-200 transition-colors duration-300 group-hover:bg-brand group-hover:text-white">
            <Icon name={service.icon} size={26} />
          </div>
          <h3 class="mt-5 text-xl font-bold">{service.title}</h3>
          <p class="mt-2 text-slate-600">{service.description}</p>
          <ul class="mt-5 flex flex-col gap-2 border-t border-slate-200 pt-5 text-sm text-slate-700">
            {service.features.map((feature) => (
              <li class="flex items-start gap-2">
                <Icon name="check" size={18} strokeWidth={2.25} class="mt-0.5 text-brand-hover" />
                {feature}
              </li>
            ))}
          </ul>
          <a
            href={`${servicesPath}#${service.slug}`}
            class="mt-auto inline-flex min-h-11 items-center gap-2 self-start rounded-md pt-5 font-bold text-brand-hover underline-offset-4 hover:underline focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-orange-500 focus-visible:ring-offset-2"
            aria-label={`${moreLabel}: ${service.title}`}
          >
            {moreLabel}
            <Icon name="arrow" size={18} />
          </a>
        </Card>
      ))}
    </ul>

    <div class="mt-10">
      <Button href={servicesPath} variant="secondary">
        {allServicesLabel}
        <Icon name="arrow" size={20} />
      </Button>
    </div>
  </div>
</section>

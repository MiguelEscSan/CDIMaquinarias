---
import Button from "../ui/Button.astro";
import Icon from "../ui/Icon.astro";
import SectionHeader from "../ui/SectionHeader.astro";
import { primaryPhone } from "@content/data/siteInfo";
import { getDictionary, localizedPath, type Locale } from "@content/i18n";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = getDictionary(locale);
const quoteCta = { href: localizedPath("contact", locale), ...t.common.cta.quote };
const callCta = { href: primaryPhone.href, ...t.common.cta.call };

const headingId = "contacto-cta-titulo";
---

<section aria-labelledby={headingId} class="border-t border-slate-200 bg-slate-50 py-14 sm:py-20">
  <div class="mx-auto flex max-w-7xl flex-col gap-8 px-4 sm:px-6 lg:flex-row lg:items-center lg:justify-between lg:px-8">
    <SectionHeader id={headingId} {...t.home.contactBand} />
    <div class="flex flex-col gap-3 sm:flex-row lg:shrink-0">
      <Button href={quoteCta.href} ariaLabel={quoteCta.ariaLabel} size="lg">
        <Icon name="mail" slot="icon" />
        {quoteCta.label}
      </Button>
      <Button href={callCta.href} ariaLabel={callCta.ariaLabel} size="lg" variant="secondary">
        <Icon name="phone" slot="icon" />
        {callCta.label}
      </Button>
    </div>
  </div>
</section>

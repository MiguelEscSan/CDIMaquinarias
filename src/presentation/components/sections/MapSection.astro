---
import Button from "../ui/Button.astro";
import Icon from "../ui/Icon.astro";
import SectionHeader from "../ui/SectionHeader.astro";
import { directionsUrl, formatAddress, mapEmbedUrl } from "@content/data/siteInfo";
import { getDictionary, localizedPath, type Locale } from "@content/i18n";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = getDictionary(locale);
const locationContent = t.contact.location;

const headingId = "ubicacion-titulo";
const { consent } = locationContent;
---

<section id="ubicacion" aria-labelledby={headingId} class="flex flex-col gap-6">
  <SectionHeader
    id={headingId}
    eyebrow={locationContent.eyebrow}
    title={locationContent.title}
    subtitle={locationContent.subtitle}
  />
  <address class="flex gap-3 text-slate-700 not-italic">
    <Icon name="map-pin" class="mt-0.5 text-brand-hover" />
    {formatAddress(t.common.countryName)}
  </address>
  <div>
    <Button
      href={directionsUrl}
      external
      variant="secondary"
      ariaLabel={locationContent.directionsAriaLabel}
    >
      {locationContent.directionsLabel}
      <Icon name="arrow" size={20} />
    </Button>
  </div>

  <div
    class="overflow-hidden rounded-2xl border border-slate-200 bg-slate-50 shadow-sm"
    data-map-consent
    data-map-src={mapEmbedUrl}
    data-map-title={locationContent.mapTitle}
  >
    <div
      class="bg-grid flex aspect-[4/3] w-full flex-col items-center justify-center gap-4 p-6 text-center sm:aspect-video sm:p-10"
      data-map-placeholder
    >
      <div class="flex size-14 items-center justify-center rounded-full bg-orange-50 text-brand-hover ring-1 ring-orange-200">
        <Icon name="map-pin" size={28} />
      </div>
      <p class="text-lg font-bold text-slate-900">{consent.title}</p>
      <p class="max-w-md text-sm text-slate-600">{consent.body}</p>
      <Button type="button" size="sm" hidden data-map-load>
        {consent.loadLabel}
      </Button>
      <a
        href={localizedPath("cookies", locale)}
        class="text-sm font-semibold text-slate-900 underline decoration-orange-300 decoration-2 underline-offset-4 hover:text-brand-hover"
      >
        {consent.cookiesLinkLabel}
      </a>
    </div>
  </div>
</section>

<script>
  import { acceptExternalServices, onExternalConsent } from "@shared/scripts/cookieConsent";

  // The Google Maps iframe exists only while the "external" consent category is accepted.
  document.querySelectorAll<HTMLElement>("[data-map-consent]").forEach((root) => {
    const placeholder = root.querySelector<HTMLElement>("[data-map-placeholder]");
    const button = root.querySelector<HTMLButtonElement>("[data-map-load]");
    if (!placeholder || !button) return;

    const showMap = (focus: boolean) => {
      let frame = root.querySelector("iframe");
      if (!frame) {
        frame = document.createElement("iframe");
        frame.src = root.dataset.mapSrc ?? "";
        frame.title = root.dataset.mapTitle ?? "";
        frame.loading = "lazy";
        frame.referrerPolicy = "strict-origin-when-cross-origin";
        frame.allowFullscreen = true;
        frame.className = "block aspect-[4/3] w-full border-0 sm:aspect-video";
        root.append(frame);
      }
      placeholder.hidden = true;
      if (focus) frame.focus();
    };

    const hideMap = () => {
      root.querySelector("iframe")?.remove();
      placeholder.hidden = false;
    };

    button.hidden = false;
    button.addEventListener("click", () => {
      acceptExternalServices();
      showMap(true);
    });
    onExternalConsent((accepted) => (accepted ? showMap(false) : hideMap()));
  });
</script>

---
import type { FaqItem } from "@shared/types";

interface Props {
  /** Unique within the page; prefixes the heading id. */
  id: string;
  title: string;
  items: FaqItem[];
}

const { id, title, items } = Astro.props;
---

<section aria-labelledby={`${id}-titulo`} class="grid gap-10 lg:grid-cols-[minmax(0,1fr)_minmax(0,1.4fr)] lg:gap-14">
  <h2
    id={`${id}-titulo`}
    class="text-3xl leading-none font-extrabold tracking-tight text-slate-900 uppercase sm:text-4xl lg:text-5xl"
  >
    {title}
  </h2>
  <div class="flex flex-col border-y border-slate-200">
    {
      items.map((item) => (
        <details class="group border-b border-slate-200 last:border-b-0" data-faq>
          <summary class="flex min-h-14 cursor-pointer list-none items-center justify-between gap-6 rounded-md py-5 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-orange-500 focus-visible:ring-offset-2 [&::-webkit-details-marker]:hidden">
            <h3 class="text-lg font-bold text-slate-900 sm:text-xl">{item.question}</h3>
            <span aria-hidden="true" class="relative size-5 shrink-0">
              <span class="absolute inset-x-0 top-1/2 h-0.5 -translate-y-1/2 bg-brand-hover"></span>
              <span class="absolute inset-y-0 left-1/2 w-0.5 -translate-x-1/2 bg-brand-hover transition-transform duration-300 group-open:rotate-90 motion-reduce:transition-none"></span>
            </span>
          </summary>
          <p class="max-w-prose pb-6 leading-relaxed text-slate-600">{item.answer}</p>
        </details>
      ))
    }
  </div>
</section>

<script>
  // Animates the answer's height when opening and closing. Without JS the native <details> toggle still works.
  const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)");
  const duration = 500;
  const easing = "cubic-bezier(0.22, 1, 0.36, 1)";

  for (const details of document.querySelectorAll<HTMLDetailsElement>("details[data-faq]")) {
    const summary = details.querySelector("summary")!;
    const closedHeight = details.offsetHeight;
    let animation: Animation | undefined;

    const animateHeight = (from: number, to: number, onDone?: () => void) => {
      animation?.cancel();
      details.style.overflow = "hidden";
      animation = details.animate(
        { height: [`${from}px`, `${to}px`] },
        { duration: reduceMotion.matches ? 0 : duration, easing },
      );
      animation.onfinish = () => {
        details.style.overflow = "";
        onDone?.();
      };
    };

    summary.addEventListener("click", (event) => {
      event.preventDefault();
      if (details.open) {
        animateHeight(details.offsetHeight, closedHeight, () => {
          details.open = false;
        });
      } else {
        details.open = true;
        animateHeight(closedHeight, details.offsetHeight);
      }
    });
  }
</script>

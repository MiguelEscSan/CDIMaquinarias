---
import Icon from "../ui/Icon.astro";
import { getServices } from "@content/data/services";
import { getDictionary, type Locale } from "@content/i18n";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const services = getServices(locale);
const { moreLabel } = getDictionary(locale).home.services;
---

<div class="bg-white py-16 sm:py-20">
  <ul class="mx-auto grid max-w-5xl gap-6 px-4 sm:px-6 md:grid-cols-2 lg:px-8">
    {services.map((service) => (
      <li class="flex flex-col gap-4 rounded-2xl border border-slate-200 bg-white p-6 shadow-sm sm:p-8">
        <div class="flex size-14 items-center justify-center rounded-xl bg-orange-50 text-brand-hover ring-1 ring-orange-200">
          <Icon name={service.icon} size={28} />
        </div>
        <h2 class="text-2xl font-extrabold tracking-tight">{service.title}</h2>
        <p class="leading-relaxed text-slate-700">{service.description}</p>
        <a
          href={service.href}
          class="mt-auto inline-flex min-h-11 items-center gap-2 self-start rounded-md font-bold text-brand-hover underline-offset-4 hover:underline focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-orange-500 focus-visible:ring-offset-2"
          aria-label={`${moreLabel}: ${service.title}`}
        >
          {moreLabel}
          <Icon name="arrow" size={18} />
        </a>
      </li>
    ))}
  </ul>
</div>

---
import "@shared/styles/global.css";
import CookieConsent from "../components/layout/CookieConsent.astro";
import { buildBreadcrumbSchema, buildLocalBusinessSchema, buildWebPageSchema } from "@shared/lib/schema";
import { getServices } from "@content/data/services";
import { absoluteUrl, contactInfo, siteMeta, stillBrand } from "@content/data/siteInfo";
import { getDictionary, hreflangAlternates, localeMeta, locales, type Locale } from "@content/i18n";
import type { BreadcrumbItem, PageId } from "@shared/types";

interface Props {
  locale: Locale;
  /** Enables hreflang alternates for pages in the route map. */
  pageId?: PageId;
  title?: string;
  description?: string;
  canonical?: string;
  ogImage?: string;
  noindex?: boolean;
  breadcrumbs?: BreadcrumbItem[];
}

const { locale, pageId } = Astro.props;
const t = getDictionary(locale);
const meta = localeMeta[locale];
const {
  title = t.seo.pages.home.title,
  description = t.seo.pages.home.description,
  canonical = absoluteUrl(Astro.url.pathname),
  ogImage = siteMeta.ogImage,
  noindex = false,
  breadcrumbs = [],
} = Astro.props;

const ogImageUrl = absoluteUrl(ogImage);
const robots = noindex ? "noindex, nofollow" : "index, follow, max-image-preview:large";
const schemas: object[] = [
  buildLocalBusinessSchema({
    site: siteMeta,
    description: t.seo.pages.home.description,
    areaServed: t.common.business.areaServed,
    catalogName: t.common.business.catalogName,
    contact: contactInfo,
    services: getServices(locale),
    brand: stillBrand,
  }),
];
schemas.push(
  buildWebPageSchema({ url: canonical, name: title, description, inLanguage: meta.htmlLang, siteUrl: siteMeta.url }),
);
if (breadcrumbs.length > 1) schemas.push(buildBreadcrumbSchema(breadcrumbs, siteMeta.url));
const alternates = pageId ? hreflangAlternates(pageId) : [];
const ogAlternateLocales = locales.filter((l) => l !== locale).map((l) => localeMeta[l].ogLocale);
---

<!doctype html>
<html lang={meta.htmlLang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {alternates.map((alt) => <link rel="alternate" hreflang={alt.hreflang} href={absoluteUrl(alt.path)} />)}
    <meta name="robots" content={robots} />
    <meta name="theme-color" content="#0f172a" />
    <meta name="format-detection" content="telephone=no" />
    <link rel="icon" href="/favicon.png" type="image/png" sizes="57x56" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <meta property="og:type" content="website" />
    <meta property="og:locale" content={meta.ogLocale} />
    {ogAlternateLocales.map((ogLocale) => <meta property="og:locale:alternate" content={ogLocale} />)}
    <meta property="og:site_name" content={siteMeta.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={siteMeta.name} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />

    {schemas.map((schema) => <script type="application/ld+json" set:html={JSON.stringify(schema)} />)}
  </head>
  <body class="min-h-screen overflow-x-clip bg-white">
    <a
      href="#contenido"
      class="sr-only focus:not-sr-only focus:fixed focus:top-3 focus:left-3 focus:z-[60] focus:rounded-lg focus:bg-navy focus:px-4 focus:py-3 focus:font-semibold focus:text-white focus:ring-2 focus:ring-orange-500"
    >
      {t.common.skipToContent}
    </a>
    <slot name="header" />
    <main id="contenido" tabindex="-1" class="focus:outline-none">
      <slot />
    </main>
    <slot name="footer" />
    <CookieConsent />
  </body>
</html>

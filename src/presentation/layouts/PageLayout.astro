---
import BaseLayout from "./BaseLayout.astro";
import Navbar from "../components/layout/Navbar.astro";
import Footer from "../components/layout/Footer.astro";
import FloatingContact from "../components/ui/FloatingContact.astro";
import PageHero from "../components/sections/PageHero.astro";
import { breadcrumbsFor } from "@content/data/pages";
import { absoluteUrl, emailHref, primaryPhone } from "@content/data/siteInfo";
import { getDictionary, type Locale } from "@content/i18n";
import type { PageMeta } from "@shared/types";

interface Props {
  page: PageMeta;
  locale: Locale;
  /** Inner pages render the shared hero with h1 + breadcrumbs; the home page renders its own. */
  hero?: boolean;
}

const { page, locale, hero = page.id !== "home" } = Astro.props;
const t = getDictionary(locale).common;
const breadcrumbs = breadcrumbsFor(page.id, locale);
---

<BaseLayout
  locale={locale}
  pageId={page.id}
  title={page.title}
  description={page.description}
  canonical={absoluteUrl(page.path)}
  breadcrumbs={breadcrumbs}
>
  <Navbar slot="header" locale={locale} pageId={page.id} />
  {
    hero && (
      <PageHero
        heading={page.heading}
        intro={page.intro}
        breadcrumbs={breadcrumbs}
        breadcrumbLabel={t.nav.breadcrumb}
      />
    )
  }
  <slot />
  <Fragment slot="footer">
    <Footer locale={locale} />
    <FloatingContact
      label={t.nav.quickContact}
      phoneHref={primaryPhone.href}
      phoneLabel={t.floatingContact.phoneLabel}
      emailHref={emailHref}
      emailLabel={t.floatingContact.emailLabel}
    />
  </Fragment>
</BaseLayout>

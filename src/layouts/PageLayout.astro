---
import BaseLayout from "./BaseLayout.astro";
import Navbar from "../components/layout/Navbar.astro";
import Footer from "../components/layout/Footer.astro";
import FloatingContact from "../components/ui/FloatingContact.astro";
import PageHero from "../components/sections/PageHero.astro";
import { floatingContact } from "../data/navigation";
import { breadcrumbsFor } from "../data/pages";
import { absoluteUrl } from "../data/siteInfo";
import type { PageMeta } from "../types";

interface Props {
  page: PageMeta;
  /** Inner pages render the shared hero with h1 + breadcrumbs; the home page renders its own. */
  hero?: boolean;
}

const { page, hero = page.id !== "home" } = Astro.props;
const breadcrumbs = breadcrumbsFor(page.id);
---

<BaseLayout
  title={page.title}
  description={page.description}
  canonical={absoluteUrl(page.path)}
  breadcrumbs={breadcrumbs}
>
  <Navbar slot="header" />
  {hero && <PageHero heading={page.heading} intro={page.intro} breadcrumbs={breadcrumbs} />}
  <slot />
  <Fragment slot="footer">
    <Footer />
    <FloatingContact {...floatingContact} />
  </Fragment>
</BaseLayout>

---
import Button from "../ui/Button.astro";
import Icon from "../ui/Icon.astro";
import { services } from "../../data/services";
---

<div class="bg-white py-16 sm:py-20">
  <div class="mx-auto flex max-w-5xl flex-col gap-8 px-4 sm:px-6 lg:px-8">
    {services.map((service) => (
      <article
        id={service.slug}
        aria-labelledby={`${service.slug}-titulo`}
        class="scroll-mt-28 rounded-2xl border border-slate-200 bg-white p-6 shadow-sm sm:p-8"
      >
        <div class="flex flex-col gap-5 sm:flex-row sm:items-start">
          <div class="flex size-14 shrink-0 items-center justify-center rounded-xl bg-orange-50 text-brand-hover ring-1 ring-orange-200">
            <Icon name={service.icon} size={28} />
          </div>
          <div class="flex min-w-0 flex-col gap-4">
            <h2 id={`${service.slug}-titulo`} class="text-2xl font-extrabold tracking-tight sm:text-3xl">
              {service.title}
            </h2>
            <p class="leading-relaxed text-slate-700">{service.detail}</p>
            <ul class="grid gap-2 text-sm text-slate-700 sm:grid-cols-2">
              {service.features.map((feature) => (
                <li class="flex items-start gap-2">
                  <Icon name="check" size={18} strokeWidth={2.25} class="mt-0.5 text-brand-hover" />
                  {feature}
                </li>
              ))}
            </ul>
            {service.link && (
              <div>
                <Button href={service.link.href} ariaLabel={service.link.ariaLabel} variant="secondary" size="sm">
                  {service.link.label}
                  <Icon name="arrow" size={18} />
                </Button>
              </div>
            )}
          </div>
        </div>
      </article>
    ))}
  </div>
</div>

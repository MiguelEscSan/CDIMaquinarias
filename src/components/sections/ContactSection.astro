---
import Button from "../ui/Button.astro";
import Card from "../ui/Card.astro";
import Icon from "../ui/Icon.astro";
import SectionHeader from "../ui/SectionHeader.astro";
import { contactContent } from "../../data/homeContent";
import { callCta, quoteCta, sectionIds } from "../../data/navigation";
import { contactInfo, emailHref, formatAddress, formatHours } from "../../data/siteInfo";

const headingId = `${sectionIds.contact}-titulo`;
const iconBox =
  "flex size-11 items-center justify-center rounded-xl bg-orange-50 text-brand-hover ring-1 ring-orange-200";
const linkClass =
  "inline-flex min-h-11 items-center rounded-md font-semibold text-slate-900 underline decoration-orange-300 decoration-2 underline-offset-4 transition-colors duration-300 hover:text-brand-hover focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-orange-500 focus-visible:ring-offset-2";
---

<section id={sectionIds.contact} aria-labelledby={headingId} class="scroll-mt-24 bg-white py-16 sm:py-24">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <SectionHeader id={headingId} {...contactContent} />

    <div class="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
      <Card interactive>
        <div class={iconBox}><Icon name="phone" /></div>
        <h3 class="mt-4 text-lg font-bold">Teléfono</h3>
        <ul class="mt-2 flex flex-col">
          {contactInfo.phones.map((phone) => (
            <li>
              <a href={phone.href} class={linkClass} aria-label={`${phone.label}: ${phone.display}`}>
                {phone.display}
              </a>
            </li>
          ))}
        </ul>
      </Card>

      <Card interactive>
        <div class={iconBox}><Icon name="mail" /></div>
        <h3 class="mt-4 text-lg font-bold">Correo electrónico</h3>
        <a href={emailHref} class={`${linkClass} mt-2 break-all`}>{contactInfo.email}</a>
      </Card>

      <Card interactive>
        <div class={iconBox}><Icon name="map-pin" /></div>
        <h3 class="mt-4 text-lg font-bold">Dirección</h3>
        <address class="mt-2 text-slate-700 not-italic">{formatAddress()}</address>
      </Card>

      <Card interactive>
        <div class={iconBox}><Icon name="clock" /></div>
        <h3 class="mt-4 text-lg font-bold">Horario</h3>
        <dl class="mt-2 flex flex-col gap-2 text-slate-700">
          {contactInfo.hours.map((entry) => (
            <div>
              <dt class="text-sm">{entry.label}</dt>
              <dd class="font-semibold text-slate-900">{formatHours(entry)}</dd>
            </div>
          ))}
        </dl>
      </Card>
    </div>

    <div class="mt-10 flex flex-col gap-3 sm:flex-row">
      <Button href={callCta.href} ariaLabel={callCta.ariaLabel} size="lg">
        <Icon name="phone" slot="icon" />
        {callCta.label}
      </Button>
      <Button href={quoteCta.href} ariaLabel={quoteCta.ariaLabel} size="lg" variant="secondary">
        <Icon name="mail" slot="icon" />
        {quoteCta.label}
      </Button>
    </div>
  </div>
</section>

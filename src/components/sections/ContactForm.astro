---
import { actions } from "astro:actions";
import Button from "../ui/Button.astro";
import Icon from "../ui/Icon.astro";
import { getDictionary, localizedPath, type Locale } from "../../i18n";
import type { ContactField, ContactFormState } from "../../lib/contactPageState";

interface Props {
  state: ContactFormState;
  locale: Locale;
}

const { state, locale } = Astro.props;
const copy = getDictionary(locale).contact.form;
const { fieldErrors, values } = state;
const headingId = "formulario-titulo";

const errorId = (field: ContactField) => `${field}-error`;
const firstError = (field: ContactField) => fieldErrors[field]?.[0];
const invalid = (field: ContactField) => (firstError(field) ? "true" : undefined);
const describedBy = (field: ContactField) => (firstError(field) ? errorId(field) : undefined);

const labelClass = "text-sm font-semibold text-slate-900";
const inputClass =
  "mt-1.5 block w-full rounded-lg border border-slate-300 bg-white px-4 py-3 text-base text-slate-900 shadow-sm placeholder:text-slate-400 focus:border-orange-500 focus:outline-none focus:ring-2 focus:ring-orange-500/40 aria-[invalid=true]:border-red-600 aria-[invalid=true]:ring-red-600/30";
const errorClass = "mt-1.5 text-sm font-medium text-red-700";
---

<section aria-labelledby={headingId} class="rounded-3xl border border-slate-200 bg-white p-6 shadow-sm sm:p-8">
  <h2 id={headingId} class="text-2xl font-extrabold tracking-tight sm:text-3xl">{copy.title}</h2>

  {
    state.success ? (
      <p
        role="status"
        class="mt-6 flex items-start gap-3 rounded-xl border border-green-200 bg-green-50 p-4 font-semibold text-green-900"
      >
        <Icon name="check" class="mt-0.5 text-green-700" strokeWidth={2.5} />
        {copy.success}
      </p>
    ) : (
      <>
        <p class="mt-2 text-slate-600">{copy.intro}</p>
        <p class="mt-1 text-sm text-slate-500">{copy.requiredNote}</p>

        {state.formError && (
          <p role="alert" class="mt-6 rounded-xl border border-red-200 bg-red-50 p-4 font-semibold text-red-800">
            {state.formError}
          </p>
        )}

        <form method="POST" action={actions.contact} class="mt-6 flex flex-col gap-5">
          <div>
            <label for="contact-name" class={labelClass}>
              {copy.fields.name} <span aria-hidden="true" class="text-red-700">*</span>
            </label>
            <input
              id="contact-name"
              name="name"
              type="text"
              required
              minlength={2}
              maxlength={100}
              autocomplete="name"
              value={values.name}
              aria-invalid={invalid("name")}
              aria-describedby={describedBy("name")}
              class={inputClass}
            />
            {firstError("name") && <p id={errorId("name")} class={errorClass}>{firstError("name")}</p>}
          </div>

          <div>
            <label for="contact-email" class={labelClass}>
              {copy.fields.email} <span aria-hidden="true" class="text-red-700">*</span>
            </label>
            <input
              id="contact-email"
              name="email"
              type="email"
              inputmode="email"
              required
              maxlength={254}
              autocomplete="email"
              value={values.email}
              aria-invalid={invalid("email")}
              aria-describedby={describedBy("email")}
              class={inputClass}
            />
            {firstError("email") && <p id={errorId("email")} class={errorClass}>{firstError("email")}</p>}
          </div>

          <div>
            <label for="contact-message" class={labelClass}>
              {copy.fields.message} <span aria-hidden="true" class="text-red-700">*</span>
            </label>
            <textarea
              id="contact-message"
              name="message"
              rows={6}
              required
              minlength={10}
              maxlength={5000}
              autocomplete="off"
              aria-invalid={invalid("message")}
              aria-describedby={describedBy("message")}
              class={`${inputClass} resize-y`}
            >{values.message}</textarea>
            {firstError("message") && (
              <p id={errorId("message")} class={errorClass}>{firstError("message")}</p>
            )}
          </div>

          <div aria-hidden="true" class="sr-only">
            <label for="contact-website">{copy.honeypotLabel}</label>
            <input id="contact-website" name="website" type="text" tabindex="-1" autocomplete="off" />
          </div>

          {state.equipo && <input type="hidden" name="equipo" value={state.equipo} />}

          <div>
            <div class="flex items-start gap-3">
              <input
                id="contact-privacy"
                name="privacy"
                type="checkbox"
                required
                checked={values.privacy}
                aria-invalid={invalid("privacy")}
                aria-describedby={describedBy("privacy")}
                class="mt-0.5 size-5 shrink-0 rounded border-slate-400 accent-orange-600"
              />
              <label for="contact-privacy" class="text-sm text-slate-700">
                {copy.privacy.before}{" "}
                <a
                  href={localizedPath("privacy", locale)}
                  class="font-semibold text-slate-900 underline decoration-orange-300 decoration-2 underline-offset-4 hover:text-brand-hover"
                >
                  {copy.privacy.linkLabel}
                </a>{" "}
                <span aria-hidden="true" class="text-red-700">*</span>
              </label>
            </div>
            {firstError("privacy") && (
              <p id={errorId("privacy")} class={errorClass}>{firstError("privacy")}</p>
            )}
          </div>

          <div>
            <Button type="submit" size="lg">
              <Icon name="mail" slot="icon" />
              {copy.submitLabel}
            </Button>
          </div>
        </form>
      </>
    )
  }
</section>

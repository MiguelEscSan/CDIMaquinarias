---
import Button from "../ui/Button.astro";
import Icon from "../ui/Icon.astro";
import SectionHeader from "../ui/SectionHeader.astro";
import { locationContent } from "../../data/contactContent";
import { directionsUrl, formatAddress, mapEmbedUrl } from "../../data/siteInfo";

const headingId = "ubicacion-titulo";
---

<section
  id="ubicacion"
  aria-labelledby={headingId}
  class="scroll-mt-24 border-t border-slate-200 bg-slate-50 py-16 sm:py-24"
>
  <div class="mx-auto grid max-w-7xl gap-10 px-4 sm:px-6 lg:grid-cols-3 lg:px-8">
    <div class="flex flex-col gap-6">
      <SectionHeader
        id={headingId}
        eyebrow={locationContent.eyebrow}
        title={locationContent.title}
        subtitle={locationContent.subtitle}
      />
      <address class="flex gap-3 text-slate-700 not-italic">
        <Icon name="map-pin" class="mt-0.5 text-brand-hover" />
        {formatAddress()}
      </address>
      <div>
        <Button
          href={directionsUrl}
          external
          variant="secondary"
          ariaLabel={`${locationContent.directionsLabel} (se abre en una pestaña nueva)`}
        >
          {locationContent.directionsLabel}
          <Icon name="arrow" size={20} />
        </Button>
      </div>
    </div>

    <div class="overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm lg:col-span-2">
      <iframe
        src={mapEmbedUrl}
        title={locationContent.mapTitle}
        loading="lazy"
        referrerpolicy="no-referrer-when-downgrade"
        allowfullscreen
        class="block aspect-[4/3] w-full border-0 sm:aspect-video"
      ></iframe>
    </div>
  </div>
</section>

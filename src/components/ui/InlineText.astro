---
import { parseInlineLinks } from "../../lib/inlineLinks";

interface Props {
  text: string;
}

const segments = parseInlineLinks(Astro.props.text);
---

{
  segments.map((segment) =>
    "href" in segment ? (
      <a
        href={segment.href}
        target={segment.external ? "_blank" : undefined}
        rel={segment.external ? "noopener noreferrer" : undefined}
      >
        {segment.text}
      </a>
    ) : (
      segment.text
    ),
  )
}

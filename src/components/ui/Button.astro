---
import type { HTMLAttributes } from "astro/types";

type Variant = "primary" | "secondary" | "outline" | "inverse" | "ghost";
type Size = "sm" | "md" | "lg";

interface Props {
  href?: string;
  variant?: Variant;
  size?: Size;
  type?: "button" | "submit" | "reset";
  ariaLabel?: string;
  external?: boolean;
  fullWidth?: boolean;
  class?: string;
  rel?: HTMLAttributes<"a">["rel"];
  hidden?: boolean;
  /** Extra data-* attributes, e.g. hooks for inline scripts. */
  [dataAttribute: `data-${string}`]: unknown;
}

const {
  href,
  variant = "primary",
  size = "md",
  type = "button",
  ariaLabel,
  external = false,
  fullWidth = false,
  class: className = "",
  rel,
  hidden,
  ...dataAttributes
} = Astro.props;

const base =
  "inline-flex items-center justify-center gap-2 rounded-lg font-bold tracking-tight transition-all duration-300 motion-reduce:transition-none focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-orange-500 focus-visible:ring-offset-2 select-none";

const variants: Record<Variant, string> = {
  primary:
    "bg-brand text-white shadow-sm hover:bg-brand-hover hover:shadow-lg hover:shadow-orange-900/20 hover:-translate-y-0.5 motion-reduce:hover:translate-y-0",
  secondary:
    "bg-navy text-white shadow-sm hover:bg-navy-deep hover:shadow-lg hover:-translate-y-0.5 motion-reduce:hover:translate-y-0",
  outline:
    "border-2 border-current text-slate-900 hover:bg-slate-900 hover:text-white hover:border-slate-900",
  inverse: "border-2 border-white/70 text-white hover:border-white hover:bg-white hover:text-slate-900",
  ghost: "text-slate-900 hover:bg-slate-100",
};

const sizes: Record<Size, string> = {
  sm: "min-h-11 px-4 text-sm",
  md: "min-h-12 px-5 text-base",
  lg: "min-h-14 px-7 text-lg",
};

const classes = [base, variants[variant], sizes[size], fullWidth ? "w-full" : "", className]
  .filter(Boolean)
  .join(" ");

const linkRel = rel ?? (external ? "noopener noreferrer" : undefined);
---

{
  href ? (
    <a
      href={href}
      class={classes}
      aria-label={ariaLabel}
      target={external ? "_blank" : undefined}
      rel={linkRel}
      hidden={hidden}
      {...dataAttributes}
    >
      <slot name="icon" />
      <slot />
    </a>
  ) : (
    <button type={type} class={classes} aria-label={ariaLabel} hidden={hidden} {...dataAttributes}>
      <slot name="icon" />
      <slot />
    </button>
  )
}

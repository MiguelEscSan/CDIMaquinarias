---
import Icon from "../ui/Icon.astro";
import { footerNav, legalNav, menuLabels } from "../../data/navigation";
import {
  contactInfo,
  emailHref,
  formatAddress,
  formatHours,
  siteMeta,
} from "../../data/siteInfo";

const year = new Date().getFullYear();
const headingClass = "font-mono text-xs font-semibold uppercase tracking-[0.2em] text-brand-accent";
const linkClass =
  "inline-flex min-h-11 items-center gap-2 rounded-md text-slate-300 transition-colors duration-300 hover:text-white focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-orange-500 focus-visible:ring-offset-2 focus-visible:ring-offset-navy";
---

<footer class="bg-navy text-slate-300">
  <div class="hazard-stripes h-1.5" aria-hidden="true"></div>
  <div class="mx-auto grid max-w-7xl gap-10 px-4 pt-14 pb-12 sm:px-6 md:grid-cols-2 lg:grid-cols-4 lg:px-8">
    <div class="flex flex-col gap-3">
      <p class="text-xl font-black tracking-tight text-white">{siteMeta.name}</p>
      <p class="text-sm">{siteMeta.positioning}</p>
      <p class="text-sm">{siteMeta.areaServed}</p>
    </div>

    <div>
      <h2 class={headingClass}>Contacto</h2>
      <ul class="mt-3 flex flex-col">
        {contactInfo.phones.map((phone) => (
          <li>
            <a href={phone.href} class={linkClass} aria-label={`${phone.label}: ${phone.display}`}>
              <Icon name="phone" size={18} />
              {phone.display}
            </a>
          </li>
        ))}
        <li>
          <a href={emailHref} class={`${linkClass} break-all`}>
            <Icon name="mail" size={18} />
            {contactInfo.email}
          </a>
        </li>
      </ul>
      <address class="mt-3 flex gap-2 text-sm not-italic">
        <Icon name="map-pin" size={18} class="mt-0.5" />
        {formatAddress()}
      </address>
    </div>

    <div>
      <h2 class={headingClass}>Horario</h2>
      <dl class="mt-3 flex flex-col gap-2 text-sm">
        {contactInfo.hours.map((entry) => (
          <div class="flex justify-between gap-4 border-b border-slate-800 pb-2">
            <dt>{entry.label}</dt>
            <dd class="font-semibold text-white">{formatHours(entry)}</dd>
          </div>
        ))}
      </dl>
    </div>

    <nav aria-label={menuLabels.footer}>
      <h2 class={headingClass}>Navegación</h2>
      <ul class="mt-3 grid grid-cols-2 gap-x-4 md:grid-cols-1">
        {footerNav.map((link) => (
          <li>
            <a href={link.href} class={linkClass}>{link.label}</a>
          </li>
        ))}
      </ul>
    </nav>
  </div>

  <div class="border-t border-slate-800">
    <div class="mx-auto flex max-w-7xl flex-col gap-3 px-4 py-6 pb-28 text-xs text-slate-400 sm:px-6 md:flex-row md:items-center md:justify-between md:pb-6 lg:px-8">
      <p>© {year} {siteMeta.legalName}. Todos los derechos reservados.</p>
      <nav aria-label={menuLabels.legal}>
        <ul class="flex flex-wrap gap-x-5">
          {legalNav.map((link) => (
            <li>
              <a href={link.href} class={linkClass}>{link.label}</a>
            </li>
          ))}
        </ul>
      </nav>
    </div>
  </div>
</footer>

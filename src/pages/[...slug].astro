---
// Every static page in every locale, generated from the route map (src/i18n/routes.ts).
// Contact stays in its own files: its form is server-rendered.
import AboutPage from "../views/AboutPage.astro";
import HomePage from "../views/HomePage.astro";
import ProductsPage from "../views/ProductsPage.astro";
import RentingPage from "../views/RentingPage.astro";
import ServicesPage from "../views/ServicesPage.astro";
import LegalLayout from "../layouts/LegalLayout.astro";
import { locales, routes, type Locale } from "../i18n";
import type { PageId } from "../types";

export function getStaticPaths() {
  const pageIds = Object.keys(routes) as PageId[];
  return pageIds
    .filter((pageId) => pageId !== "contact")
    .flatMap((pageId) => locales.map((locale: Locale) => ({ pageId, locale, path: routes[pageId][locale] })))
    .filter(({ path }) => path !== "/") // Spanish home is src/pages/index.astro
    .map(({ pageId, locale, path }) => ({
      params: { slug: path.replace(/^\/|\/$/g, "") },
      props: { pageId, locale },
    }));
}

const { pageId, locale } = Astro.props;
---

{pageId === "home" && <HomePage locale={locale} />}
{pageId === "about" && <AboutPage locale={locale} />}
{pageId === "services" && <ServicesPage locale={locale} />}
{pageId === "products" && <ProductsPage locale={locale} />}
{pageId === "renting" && <RentingPage locale={locale} />}
{pageId === "legalNotice" && <LegalLayout id="legalNotice" locale={locale} />}
{pageId === "privacy" && <LegalLayout id="privacy" locale={locale} />}
{pageId === "cookies" && <LegalLayout id="cookies" locale={locale} />}

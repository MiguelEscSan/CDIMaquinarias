---
// Every static page in every locale, generated from the route map (src/content/i18n/routes.ts).
// Contact stays in its own files: its form is server-rendered.
import AboutPage from "@presentation/views/AboutPage.astro";
import HomePage from "@presentation/views/HomePage.astro";
import ProductsPage from "@presentation/views/ProductsPage.astro";
import AdvisoryPage from "@presentation/views/AdvisoryPage.astro";
import RentingPage from "@presentation/views/RentingPage.astro";
import RepairPage from "@presentation/views/RepairPage.astro";
import ServicePage from "@presentation/views/ServicePage.astro";
import ServicesPage from "@presentation/views/ServicesPage.astro";
import LegalLayout from "@presentation/layouts/LegalLayout.astro";
import { isServiceId } from "@content/data/services";
import { locales, routes, type Locale } from "@content/i18n";
import type { PageId } from "@shared/types";

export function getStaticPaths() {
  const pageIds = Object.keys(routes) as PageId[];
  return pageIds
    .filter((pageId) => pageId !== "contact")
    .flatMap((pageId) => locales.map((locale: Locale) => ({ pageId, locale, path: routes[pageId][locale] })))
    .filter(({ path }) => path !== "/") // Spanish home is src/pages/index.astro
    .map(({ pageId, locale, path }) => ({
      params: { slug: path.replace(/^\/|\/$/g, "") },
      props: { pageId, locale },
    }));
}

const { pageId, locale } = Astro.props;
---

{pageId === "home" && <HomePage locale={locale} />}
{pageId === "about" && <AboutPage locale={locale} />}
{pageId === "services" && <ServicesPage locale={locale} />}
{pageId === "products" && <ProductsPage locale={locale} />}
{pageId === "renting" && <RentingPage locale={locale} />}
{pageId === "legalNotice" && <LegalLayout id="legalNotice" locale={locale} />}
{pageId === "privacy" && <LegalLayout id="privacy" locale={locale} />}
{pageId === "cookies" && <LegalLayout id="cookies" locale={locale} />}
{pageId === "reparacion-mantenimiento" && <RepairPage locale={locale} />}
{pageId === "asesoramiento-especializado" && <AdvisoryPage locale={locale} />}
{isServiceId(pageId) && pageId !== "reparacion-mantenimiento" && pageId !== "asesoramiento-especializado" && <ServicePage serviceId={pageId} locale={locale} />}

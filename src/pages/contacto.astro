---
import ContactPage from "@presentation/views/ContactPage.astro";
import { resolveContactPageState } from "@presentation/views/contactPageState";

// On-demand so the form works without JavaScript via Astro Actions.
export const prerender = false;

const { state, status } = await resolveContactPageState(Astro, "es");
if (status) Astro.response.status = status;
---

<ContactPage locale="es" state={state} />

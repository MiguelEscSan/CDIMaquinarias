---
import BaseLayout from "../layouts/BaseLayout.astro";
import Navbar from "../components/layout/Navbar.astro";
import Footer from "../components/layout/Footer.astro";
import FloatingContact from "../components/ui/FloatingContact.astro";
import Hero from "../components/sections/Hero.astro";
import ServicesSection from "../components/sections/ServicesSection.astro";
import BrandTrust from "../components/sections/BrandTrust.astro";
import ContactSection from "../components/sections/ContactSection.astro";
import MapSection from "../components/sections/MapSection.astro";
import { floatingContact } from "../data/navigation";
---

<BaseLayout>
  <Navbar slot="header" />
  <Hero />
  <ServicesSection />
  <BrandTrust />
  <ContactSection />
  <MapSection />
  <Fragment slot="footer">
    <Footer />
    <FloatingContact {...floatingContact} />
  </Fragment>
</BaseLayout>

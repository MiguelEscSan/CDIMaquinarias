{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cdi-maquinarias",
  "main": "@astrojs/cloudflare/entrypoints/server",
  // Keep in the past; bump deliberately after checking the Workers changelog.
  "compatibility_date": "2026-09-29",
  // Required by Nodemailer (node:net, node:tls, node:crypto, ...).
  "compatibility_flags": ["nodejs_compat"],
  // Static output only; the server bundle lives in dist/server and must never be public.
  "assets": {
    "binding": "ASSETS",
    "directory": "./dist/client"
  },
  // Optional: shared contact-form rate limiter in Workers KV. Without it the site
  // uses a per-instance in-memory limiter and deploys fine. To enable it:
  //   1. npx wrangler kv namespace create CONTACT_RATE_LIMIT
  //   2. paste the returned id below and uncomment the block.
  // "kv_namespaces": [
  //   { "binding": "CONTACT_RATE_LIMIT", "id": "<namespace id>" }
  // ],
  "observability": {
    "enabled": true,
    "logs": { "enabled": true }
  }
  // Secrets (SMTP_HOST, SMTP_PORT, SMTP_SECURE, SMTP_USER, SMTP_PASS, CONTACT_TO)
  // are set with `npx wrangler secret put <NAME>`; locally they come from .dev.vars.
}

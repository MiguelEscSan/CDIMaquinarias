{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cdi-maquinarias",
  "main": "@astrojs/cloudflare/entrypoints/server",
  // Keep in the past; bump deliberately after checking the Workers changelog.
  "compatibility_date": "2026-09-29",
  // Required by Nodemailer (node:net, node:tls, node:crypto, ...).
  "compatibility_flags": ["nodejs_compat"],
  // Static output only; the server bundle lives in dist/server and must never be public.
  "assets": {
    "binding": "ASSETS",
    "directory": "./dist/client"
  },
  // Shared contact-form rate limiter (created with `npx wrangler kv namespace create CONTACT_RATE_LIMIT`).
  "kv_namespaces": [{ "binding": "CONTACT_RATE_LIMIT", "id": "14d3ada303b44ff7a5a882ba0694aedf" }],
  "observability": {
    "enabled": true,
    "logs": { "enabled": true }
  }
  // Secrets (SMTP_HOST, SMTP_PORT, SMTP_SECURE, SMTP_USER, SMTP_PASS, CONTACT_TO)
  // are set with `npx wrangler secret put <NAME>`; locally they come from .dev.vars.
}

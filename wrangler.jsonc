{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cdi-maquinarias",
  "main": "@astrojs/cloudflare/entrypoints/server",
  // Keep in the past; bump deliberately after checking the Workers changelog.
  "compatibility_date": "2026-09-29",
  // Required by Nodemailer (node:net, node:tls, node:crypto, ...).
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "binding": "ASSETS",
    "directory": "./dist"
  },
  "kv_namespaces": [
    {
      // Contact form rate limiter. Create the namespace once with
      //   npx wrangler kv namespace create CONTACT_RATE_LIMIT
      // and paste the returned id here. Without the binding the site falls back
      // to the per-instance in-memory limiter.
      "binding": "CONTACT_RATE_LIMIT",
      "id": "00000000000000000000000000000000"
    }
  ],
  "observability": {
    "enabled": true,
    "logs": { "enabled": true }
  }
  // Secrets (SMTP_HOST, SMTP_PORT, SMTP_SECURE, SMTP_USER, SMTP_PASS, CONTACT_TO)
  // are set with `npx wrangler secret put <NAME>`; locally they come from .dev.vars.
}
